class Solution {

    public int maxPalindromes(String s, int k) {

        int n = s.length();

        int[] dp = new int[n + 1];
        boolean[] pal = new boolean[n];

        for (int i = n - 1; i >= 0; i--) {

            dp[i] = dp[i + 1];

            // RIGHT TO LEFT
            for (int j = n - 1; j >= i; j--) {

                if (s.charAt(i) == s.charAt(j) &&
                    (j - i <= 1 || pal[j - 1])) {

                    pal[j] = true;

                } else {

                    pal[j] = false;
                }

                if (pal[j] && j - i + 1 >= k) {

                    dp[i] = Math.max(dp[i], 1 + dp[j + 1]);
                }
            }
        }

        return dp[0];
    }
}
