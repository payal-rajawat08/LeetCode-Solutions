import java.util.*;

class Solution {
    int i = 0;

    public List<String> braceExpansionII(String expression) {
        Set<String> result = parse(expression);
        
        List<String> ans = new ArrayList<>(result);
        Collections.sort(ans);
        return ans;
    }
    private Set<String> parse(String s) {
        Set<String> result = new HashSet<>();
        result.add("");

        while (i < s.length() && s.charAt(i) != '}' && s.charAt(i) != ',') {
            Set<String> current;

            if (s.charAt(i) == '{') {
                i++; // skip 
                current = parseUnion(s);
                i++; // skip 
            } else {
                current = new HashSet<>();
                current.add(String.valueOf(s.charAt(i)));
                i++;
            }

            result = concatenate(result, current);
        }

        return result;
    }
    private Set<String> parseUnion(String s) {
        Set<String> result = new HashSet<>();

        while (true) {
            Set<String> part = parse(s);
            result.addAll(part);

            if (s.charAt(i) == ',') {
                i++; // skip 
            } else {
                break;
            }
        }

        return result;
    }
    private Set<String> concatenate(Set<String> a, Set<String> b) {
        Set<String> result = new HashSet<>();

        for (String x : a) {
            for (String y : b) {
                result.add(x + y);
            }
        }

        return result;
    }
}
