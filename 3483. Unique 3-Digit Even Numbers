class Solution {
    public int totalNumbers(int[] digits) {

        int count = 0;
        boolean[] used = new boolean[1000];

        for (int i = 0; i < digits.length; i++) {

            if (digits[i] % 2 != 0) {
                continue;
            }

            for (int j = 0; j < digits.length; j++) {

                if (j == i) {
                    continue;
                }

                if (digits[j] == 0) {
                    continue;
                }

                for (int k = 0; k < digits.length; k++) {

                    if (k == i || k == j) {
                        continue;
                    }

                    int num = digits[j] * 100 + digits[k] * 10 + digits[i];

                    if (!used[num]) {
                        count++;
                        used[num] = true;
                    }
                }
            }
        }

        return count;
    }
}
